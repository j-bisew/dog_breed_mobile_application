<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lilac_background">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <!-- Tytuł -->
        <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="Wynik analizy"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

        <!-- Karta z wynikiem -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:radius="20dp"
                android:elevation="8dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_background">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- Zdjęcie psa -->
                <ImageView
                        android:id="@+id/resultImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background"
                        android:contentDescription="Zdjęcie psa"
                        android:layout_marginBottom="16dp" />

                <!-- Nazwa rasy -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/breedName"
                        android:text="Golden Retriever"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                <!-- Pewność -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/confidenceText"
                        android:text="Pewność: 92%"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="12dp" />

                <!-- Opis -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/breedDescription"
                        android:text="Golden Retriever to przyjazna, inteligentna rasa psa..."
                        android:textColor="@color/text_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spróbuj ponownie -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/tryAgainButton"
                android:text="Spróbuj ponownie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
