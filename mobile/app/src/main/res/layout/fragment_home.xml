<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lilac_background"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/app_background"
                android:paddingTop="48dp"
                android:paddingBottom="32dp"
                android:paddingHorizontal="24dp"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:id="@+id/appNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WoofDetect"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Identify dog breeds from photos"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.85"/>

        </LinearLayout>

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
                android:id="@+id/mainCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center">

                <!-- Icon with background circle -->
                <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="20dp">

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="@color/primary_light"
                            android:alpha="0.15"/>

                    <ImageView
                            android:id="@+id/logoImage"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_dog"
                            app:tint="@color/primary"
                            android:contentDescription="Logo"/>
                </FrameLayout>

                <!-- Title -->
                <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready to identify?"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp"/>

                <!-- Subtitle -->
                <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Take a photo or choose from your gallery to discover your dog's breed"
                        android:textAlignment="center"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_secondary"
                        android:alpha="0.9"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/mainCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <!-- Camera Button -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/cameraButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/take_a_photo"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    app:icon="@drawable/photo_camera_24dp_000000_fill0_wght300_grad0_opsz24"
                    app:iconGravity="start"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:backgroundTint="@color/button"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    android:layout_marginBottom="12dp"/>

            <!-- Gallery Button -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/galleryButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/choose_from_gallery"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    app:icon="@drawable/image_24dp_000000_fill0_wght300_grad0_opsz24"
                    app:iconGravity="start"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:backgroundTint="@color/button_secondary"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    android:layout_marginBottom="20dp"/>

            <!-- Divider -->
            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline"
                    android:alpha="0.5"
                    android:layout_marginVertical="8dp"/>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/logout"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.01"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="24dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>